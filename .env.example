BOT_TOKEN=
# На Railway подставляется из плагина Postgres: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:pass@host:5432/vitalis
# Необязательно. Если задан, подключение с проверкой verify-full по этому сертификату
PG_SSL_ROOT_CERT=
ADMIN_IDS=123,456
# 32+ случайных байт: python -c "import secrets; print(secrets.token_urlsafe(48))"
TICKET_HMAC_SECRET=
# [TODO] страница политики Vitalis на сайте JBD
PRIVACY_POLICY_URL=
# [TODO] могут быть пустыми
CLUB_CHANNEL_URL=
CLUB_CHAT_URL=
# пусто = почта выключена
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# аварийный выключатель виджетов
WIDGETS_ENABLED=true
